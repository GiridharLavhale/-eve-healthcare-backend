# Application Settings
PROJECT_NAME="EVE Healthcare Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql+psycopg://eve_user:eve_password@localhost:5432/eve_healthcare"

# Security & JWT Authentication
# Generate a strong 256-bit secret key in production (e.g. using openssl rand -hex 32)
JWT_SECRET_KEY="supersecret-jwt-key-change-this-in-production-environments-eve-healthcare"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Logging
LOG_LEVEL="INFO"
